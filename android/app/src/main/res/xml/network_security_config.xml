<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Local AI talks to the user's own Ollama server on their Wi-Fi (http://192.168.x.x:11434),
         which has no https. Everything else the app loads is https. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
