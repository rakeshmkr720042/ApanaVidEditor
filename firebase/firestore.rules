rules_version = '2';

// Apna Editor accounts and subscriptions.
// Default deny. The app may read its own records, create its own Free profile once, and edit two profile fields.
// Plans, subscriptions, payments, roles and account status are written by Cloud Functions only
// (the Admin SDK bypasses these rules), so nothing on the device can grant itself Pro.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // users/{uid}: profile + a read-only copy of the plan for display.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // The app may create its own profile once, only as an active Free user with its own email.
      // (The Cloud Function does the same when it runs; whichever is first wins.)
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['fullName', 'email', 'emailLower', 'phoneNumber', 'photoURL', 'role', 'accountStatus', 'planId', 'proUntil', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['fullName', 'email', 'emailLower', 'phoneNumber', 'photoURL', 'role', 'accountStatus', 'planId', 'proUntil', 'createdAt', 'updatedAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailLower == request.auth.token.email.lower()
        && validPhone(request.resource.data.phoneNumber)
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 1000
        && request.resource.data.role == 'user'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.planId == 'free'
        && request.resource.data.proUntil == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      allow update: if isOwner(uid)
        && resource.data.accountStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phoneNumber', 'updatedAt'])
        && validName(request.resource.data.fullName)
        && validPhone(request.resource.data.phoneNumber)
        && request.resource.data.updatedAt == request.time;
    }

    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 80; }
    // Empty, or E.164 (+ then 8-15 digits).
    function validPhone(p) { return p is string && (p == '' || p.matches('^\\+[1-9][0-9]{7,14}$')); }

    // Plans and the Free/Pro feature split: everyone signed in reads, nobody writes from the app.
    match /subscription_plans/{planId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /subscriptions/{id} {
      // (The own Free id is readable even before it exists, so the app can check for it.)
      allow read: if isAdmin() || (signedIn() && (id == 'free_' + request.auth.uid || resource.data.userId == request.auth.uid));
      // Only the caller's own Free record, exactly as the server would write it. Paid plans: server only.
      allow create: if signedIn() && id == 'free_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'planId', 'planName', 'provider', 'status', 'startDate', 'expiryDate', 'autoRenewal', 'providerRef'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.planId == 'free'
        && request.resource.data.planName == 'Free Forever'
        && request.resource.data.provider == 'free'
        && request.resource.data.status == 'active'
        && request.resource.data.startDate == request.time
        && request.resource.data.expiryDate == null
        && request.resource.data.autoRenewal == false
        && request.resource.data.providerRef == null;
      allow update, delete: if false;
    }

    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /security_events/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
