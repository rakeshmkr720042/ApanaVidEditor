rules_version = '2';

// Apna Editor accounts and subscriptions.
// Default deny. The app may read its own records, create its own Free profile once, and edit two profile fields.
// Subscriptions, payments and roles are written by the server only (the Admin SDK bypasses these rules).
// An admin (custom claim set by the server) may also change plans, the Free/Pro feature split, and a
// user's status or Pro date from the admin screen; every such change must come with a security_events
// record written in the same batch (see audited()), so nothing is changed without a trace.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // The change names a security event (lastChangeId) that this same admin writes in the same batch.
    function audited() {
      let ev = getAfter(/databases/$(database)/documents/security_events/$(request.resource.data.lastChangeId));
      return request.resource.data.lastChangeId is string
        && ev.data.actorUid == request.auth.uid
        && ev.data.createdAt == request.time;
    }

    // users/{uid}: profile + a read-only copy of the plan for display.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // The app may create its own profile once, only as an active Free user with its own email.
      // (The Cloud Function does the same when it runs; whichever is first wins.)
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['fullName', 'email', 'emailLower', 'phoneNumber', 'photoURL', 'role', 'accountStatus', 'planId', 'proUntil', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['fullName', 'email', 'emailLower', 'phoneNumber', 'photoURL', 'role', 'accountStatus', 'planId', 'proUntil', 'createdAt', 'updatedAt'])
        && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 80
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.emailLower == request.auth.token.email.lower()
        && validPhone(request.resource.data.phoneNumber)
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 1000
        && request.resource.data.role == 'user'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.planId == 'free'
        && request.resource.data.proUntil == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      allow update: if isOwner(uid)
        && resource.data.accountStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phoneNumber', 'updatedAt'])
        && validName(request.resource.data.fullName)
        && validPhone(request.resource.data.phoneNumber)
        && request.resource.data.updatedAt == request.time;
      // Email offers and updates: the user's own choice (off unless they tick it), with the server's time
      // of the last change as the record of consent.
      allow update: if isOwner(uid)
        && resource.data.accountStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marketingOptIn', 'marketingOptInAt', 'updatedAt'])
        && request.resource.data.marketingOptIn is bool
        && request.resource.data.marketingOptInAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Owner deletes their account: the profile is emptied and marked deleted (kept only so payment
      // records still point at something); the app then deletes the sign-in itself. No way back.
      allow update: if isOwner(uid)
        && resource.data.accountStatus == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'email', 'emailLower', 'phoneNumber', 'photoURL', 'accountStatus', 'deletedAt', 'updatedAt', 'marketingOptIn'])
        && request.resource.data.accountStatus == 'deleted'
        && (!('marketingOptIn' in request.resource.data) || request.resource.data.marketingOptIn == false)
        && request.resource.data.fullName == '' && request.resource.data.email == '' && request.resource.data.emailLower == ''
        && request.resource.data.phoneNumber == '' && request.resource.data.photoURL == ''
        && request.resource.data.deletedAt == request.time
        && request.resource.data.updatedAt == request.time;
      // Free trial: once per account, started by the app after sign-in with a verified email. It starts at
      // the server's time and lasts the admin's number of days (config/entitlements.trialDays, default 30),
      // both checked here, so neither the phone's clock nor the app can stretch it (end = start + days). The same batch must create trials/{sha256(email)}, which
      // can never be created twice: a deleted account signed up again with that email gets no new trial.
      allow update: if isOwner(uid)
        && resource.data.accountStatus == 'active'
        && !('trialStartedAt' in resource.data)
        && request.auth.token.email_verified == true
        && trialDays() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trialStartedAt', 'trialDays', 'updatedAt'])
        && request.resource.data.trialStartedAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.trialDays == trialDays()
        && !exists(/databases/$(database)/documents/trials/$(emailKey()))
        && getAfter(/databases/$(database)/documents/trials/$(emailKey())).data.userId == uid;
      // Admin: suspend / activate (never their own account, never a deleted one) and give or remove Pro.
      allow update: if isAdmin()
        && resource.data.accountStatus in ['active', 'suspended']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountStatus', 'proUntil', 'planId', 'updatedAt', 'lastChangeId'])
        && request.resource.data.accountStatus in ['active', 'suspended']
        && (uid != request.auth.uid || request.resource.data.accountStatus == resource.data.accountStatus)
        && (request.resource.data.proUntil == null || request.resource.data.proUntil is timestamp)
        && request.resource.data.planId is string && request.resource.data.planId.size() <= 40
        && request.resource.data.updatedAt == request.time
        && audited();
    }

    // Days of free trial the admin set (0 = no trial).
    function trialDays() {
      let p = /databases/$(database)/documents/config/entitlements;
      return exists(p) && ('trialDays' in get(p).data) ? get(p).data.trialDays : 30;
    }
    // The signed-in email, hashed, so emails of deleted accounts are not kept in plain text.
    function emailKey() { return hashing.sha256(request.auth.token.email.lower().toUtf8()).toHexString().lower(); }

    // One record per email that ever had a trial. Never changed or removed.
    match /trials/{key} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.auth.token.email_verified == true
        && key == emailKey()
        && request.resource.data.keys().hasOnly(['userId', 'startedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.startedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.trialStartedAt == request.time;
      allow update, delete: if false;
    }

    function validName(n) { return n is string && n.size() >= 1 && n.size() <= 80; }
    // Empty, or E.164 (+ then 8-15 digits).
    function validPhone(p) { return p is string && (p == '' || p.matches('^\\+[1-9][0-9]{7,14}$')); }

    // Plans and the Free/Pro feature split: everyone signed in reads; only an admin changes them.
    // Prices and the Free/Pro split are public: the app is used without an account until someone buys Pro.
    match /subscription_plans/{planId} {
      allow read: if true;
      allow create, update: if isAdmin() && validPlan(planId, request.resource.data) && audited();
      allow delete: if false; // switch a plan off with isActive instead, so old subscriptions keep their plan
    }
    match /config/{docId} {
      allow read: if docId == 'entitlements' || signedIn();
      allow create, update: if isAdmin() && docId == 'entitlements' && validEntitlements(request.resource.data) && audited();
      allow delete: if false;
    }

    function validPlan(id, d) {
      return d.keys().hasOnly(['planName', 'price', 'currency', 'durationMonths', 'isActive', 'sortOrder', 'playProductId', 'playBasePlanId', 'updatedAt', 'lastChangeId'])
        && d.keys().hasAll(['planName', 'price', 'currency', 'durationMonths', 'isActive', 'sortOrder'])
        && d.planName is string && d.planName.size() >= 1 && d.planName.size() <= 40
        && d.price is int && d.price >= 0 && d.price <= 10000000
        && d.currency == 'INR'
        && d.durationMonths in [0, 1, 3, 6, 12]
        && d.isActive is bool
        && d.sortOrder is int
        && (!('playProductId' in d) || d.playProductId == null || d.playProductId is string)
        && (!('playBasePlanId' in d) || d.playBasePlanId == null || d.playBasePlanId is string)
        // Free stays free and forever; a paid plan has a length.
        && (id == 'free' ? (d.price == 0 && d.durationMonths == 0) : (d.price > 0 && d.durationMonths > 0));
    }

    function validEntitlements(d) {
      return d.keys().hasOnly(['proFeatures', 'freeExportMaxHeight', 'freeWatermark', 'offlineGraceDays', 'trialDays', 'updatedAt', 'lastChangeId'])
        && (!('trialDays' in d) || (d.trialDays is int && d.trialDays >= 0 && d.trialDays <= 90))
        && d.proFeatures is list
        && d.proFeatures.hasOnly(['export2k', 'batch', 'nomark', 'dub', 'audio', 'greenscreen', 'presenter', 'scenes'])
        && d.freeExportMaxHeight in [720, 1080, 1440, 2160]
        && d.freeWatermark is bool
        && d.offlineGraceDays is int && d.offlineGraceDays >= 1 && d.offlineGraceDays <= 30;
    }

    match /subscriptions/{id} {
      // (The own Free id is readable even before it exists, so the app can check for it.)
      allow read: if isAdmin() || (signedIn() && (id == 'free_' + request.auth.uid || resource.data.userId == request.auth.uid));
      // Only the caller's own Free record, exactly as the server would write it. Paid plans: server only.
      allow create: if signedIn() && id == 'free_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'planId', 'planName', 'provider', 'status', 'startDate', 'expiryDate', 'autoRenewal', 'providerRef'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.planId == 'free'
        && request.resource.data.planName == 'Free Forever'
        && request.resource.data.provider == 'free'
        && request.resource.data.status == 'active'
        && request.resource.data.startDate == request.time
        && request.resource.data.expiryDate == null
        && request.resource.data.autoRenewal == false
        && request.resource.data.providerRef == null;
      allow update, delete: if false;
    }

    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Audit trail. Only admins read it. An admin's own changes add a record (with their uid and the
    // server time), which can never be edited or deleted.
    match /security_events/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['type', 'actorUid', 'actorEmail', 'targetUid', 'target', 'details', 'createdAt'])
        && request.resource.data.type in ['plan_change', 'entitlements_change', 'user_suspend', 'user_activate', 'pro_grant', 'pro_remove', 'users_export']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.details is map;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
